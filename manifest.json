{
  "id": "piggy-bank",
  "contexts": ["household", "shared_space"],
  "name": "Piggy Bank",
  "version": "1.2.0",
  "description": "Per-member piggy banks for money, screen time, and savings goals. Adults manage everyone's banks; kids see their own balances and progress toward what they are working for. Automatically receives chore allowance deposits from the Chores app, and can debit a screen-time bank when a reward is redeemed.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "money",
    "allowance",
    "screen-time",
    "savings",
    "kids"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "piggy_banks": {"sql": "SELECT * FROM app_piggy_bank__piggy_banks ORDER BY member_id, type"},
    "transactions": {"sql": "SELECT bank_id, COALESCE(SUM(amount), 0) AS tail FROM app_piggy_bank__transactions GROUP BY bank_id"},
    "bank_rollups": {"sql": "SELECT bank_id, amount FROM app_piggy_bank__bank_rollups"},
    "savings_goals": {"sql": "SELECT * FROM app_piggy_bank__savings_goals WHERE status = 'active' ORDER BY created_at"}
  },
    "member_references": {
      "piggy_banks": {
        "column": "member_id",
        "on_removed": "delete",
        "dependent_tables": [
          {
            "table": "transactions",
            "foreign_key": "bank_id"
          }
        ]
      },
      "transactions": [
        {
          "column": "member_id",
          "on_removed": "delete"
        },
        {
          "column": "actor_id",
          "on_removed": "keep"
        }
      ],
      "savings_goals": {
        "column": "member_id",
        "on_removed": "delete"
      },
      "bank_rollups": {
        "column": "member_id",
        "on_removed": "delete",
        "id_column": "rowid"
      }
    },
  "delete_cascades": {
    "piggy_banks": [
      { "table": "transactions", "foreign_key": "bank_id" },
      { "table": "bank_rollups", "foreign_key": "bank_id" }
    ]
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT printf('%.2f', COALESCE(SUM(balance), 0) / 100.0) AS value FROM app_piggy_bank__piggy_banks WHERE member_id = :me AND type = 'money' LIMIT 1"
    },
    "display": {
      "template": "stat",
      "value": "value",
      "label": "saved up",
      "empty_hides": true
    }
  },
  "row_policies": {
    "piggy_banks": { "kind": "adult_writable", "member_read_column": "member_id" },
    "savings_goals": { "kind": "adult_writable", "member_read_column": "member_id" },
    "transactions": {
      "kind": "adult_writable",
      "member_read_column": "member_id",
      "retain_days": {
        "default": 730,
        "timestamp_column": "created_at",
        "override_key": "transaction_history",
        "fold": {
          "into_table": "bank_rollups",
          "key_columns": { "bank_id": "bank_id", "member_id": "member_id" },
          "sum_columns": { "amount": "amount" },
          "folded_through_column": "folded_through_at"
        }
      }
    },
    "bank_rollups": { "kind": "adult_writable", "member_read_column": "member_id" },
    "processed_events": {
      "kind": "adult_only",
      "retain_days": { "default": 90, "timestamp_column": "processed_at", "id_column": "event_id", "override_key": "event_dedup",
        "tier": "operational" }
    }
  },
  "subscribes_to": [
    "allowance.earned",
    "reward.earned"
  ],
  "automation_actions": {
    "deposit": {
      "title": "Deposit into a piggy bank",
      "description": "Add money to a member's money piggy bank.",
      "params": {
        "member_id": { "type": "member", "label": "Whose bank", "required": true },
        "amount_cents": { "type": "integer", "label": "Amount (cents)", "required": true, "min": 1 },
        "note": { "type": "text", "label": "Note", "default": "Automation" }
      },
      "dedupe": { "table": "transactions", "column": "source_event_id" },
      "steps": [
        {
          "op": "lookup",
          "table": "piggy_banks",
          "where": { "member_id": ":member_id", "type": "money" },
          "bind": { "bank_id": "id" },
          "on_missing": "skip"
        },
        {
          "op": "insert",
          "table": "transactions",
          "values": {
            "id": "$uuid",
            "bank_id": ":bank_id",
            "member_id": ":member_id",
            "actor_id": "automation",
            "amount": ":amount_cents",
            "note": ":note",
            "source": "automation",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        },
        {
          "op": "increment",
          "table": "piggy_banks",
          "set": { "balance": ":amount_cents" },
          "where": { "id": ":bank_id" }
        }
      ]
    },
    "withdraw": {
      "title": "Withdraw from a screen-time piggy bank",
      "description": "Subtract minutes from a member's screen-time piggy bank (e.g. when they spend banked time on a reward).",
      "params": {
        "member_id": { "type": "member", "label": "Whose bank", "required": true },
        "amount": { "type": "integer", "label": "Minutes to spend", "required": true, "min": 1 },
        "note": { "type": "text", "label": "Note", "default": "Automation" }
      },
      "dedupe": { "table": "transactions", "column": "source_event_id" },
      "steps": [
        {
          "op": "lookup",
          "table": "piggy_banks",
          "where": { "member_id": ":member_id", "type": "screen_time" },
          "bind": { "bank_id": "id" },
          "on_missing": "skip"
        },
        {
          "op": "insert",
          "table": "transactions",
          "values": {
            "id": "$uuid",
            "bank_id": ":bank_id",
            "member_id": ":member_id",
            "actor_id": "automation",
            "amount": "-:amount",
            "note": ":note",
            "source": "automation",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        },
        {
          "op": "increment",
          "table": "piggy_banks",
          "set": { "balance": "-:amount" },
          "where": { "id": ":bank_id" }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Deposit an allowance when a chore is completed",
      "description": "Every completed chore deposits its point value (as cents) into the member's money piggy bank. Adjust the factor to set what a point is worth.",
      "trigger_event": "chore.completed",
      "target_app_id": "piggy-bank",
      "action_id": "deposit",
      "param_map": {
        "member_id": { "kind": "payload_field", "value": "member_id" },
        "amount_cents": { "kind": "scaled_field", "value": "points", "factor": 10 }
      }
    },
    {
      "title": "Spend screen time when a reward is redeemed",
      "description": "When a reward is redeemed, subtract its point cost (as minutes) from the member's screen-time piggy bank. Adjust the factor to change the minutes-per-point rate.",
      "trigger_event": "reward.redeemed",
      "target_app_id": "piggy-bank",
      "action_id": "withdraw",
      "param_map": {
        "member_id": { "kind": "payload_field", "value": "member_id" },
        "amount": { "kind": "scaled_field", "value": "cost_points", "factor": 1 }
      }
    }
  ],
  "exports": [
    "member-balances",
    "savings-goals"
  ],
  "nav": {
    "label": "Piggy Bank"
  },
  "widget": {
    "label": "Piggy Bank",
    "size": "small"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🐷"
}
