    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "consumes": ["allowance.weekly"],
  "nav": { "label": "Piggy Bank", "icon": "🐷" },
  "widget": { "label": "Piggy Bank", "size": "small" },
  "resource_limits": {
    "max_db_bytes": 52428800
  }
}
